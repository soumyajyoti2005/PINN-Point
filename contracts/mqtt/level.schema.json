{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MQTT Level Sensor Payload",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "level_m": {
      "type": "number",
      "minimum": 0
    },
    "battery": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": ["v", "ts", "level_m"],
  "additionalProperties": false,
  "x-version": "1.0.0"
}
