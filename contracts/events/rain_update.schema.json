{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Rain Update Payload",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "rain_update"
    },
    "zone_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,50}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "intensity_mm_hr": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": ["v", "type", "zone_id", "ts", "intensity_mm_hr"],
  "additionalProperties": false,
  "x-version": "1.0.0"
}
