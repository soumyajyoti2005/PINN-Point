{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Detection Payload",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "detection"
    },
    "detection": {
      "type": "object",
      "properties": {
        "detection_id": {
          "type": "integer"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "top_pipe_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,50}$"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pipe_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,50}$"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["pipe_id", "score"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "status": {
          "type": "string",
          "enum": ["new", "confirmed", "false_alarm", "resolved"],
          "default": "new"
        }
      },
      "required": ["detection_id", "ts", "top_pipe_id", "confidence", "candidates"],
      "additionalProperties": false
    }
  },
  "required": ["v", "type", "detection"],
  "additionalProperties": false,
  "x-version": "1.0.0"
}
