# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pinnpoint

# InfluxDB
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=change-me-please
INFLUXDB_INIT_ORG=pinnpoint
INFLUXDB_INIT_BUCKET=sensors
INFLUXDB_INIT_ADMIN_TOKEN=change-me-token

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CHANNEL=pinnpoint.events

# MQTT
MQTT_BROKER=mosquitto
MQTT_HOST_PORT=1883
MQTT_PORT=1883
# MQTT_USERNAME=dev
# MQTT_PASSWORD=change-me

# API
API_PORT=8000
DATA_HOST_PATH=./data
DATA_DIR=/data
CONTRACTS_HOST_PATH=./contracts
CONTRACTS_DIR=/contracts
CORS_ORIGINS=http://localhost:3000

# Gateway
GATEWAY_PORT=8080
WS_TOKEN=change-me-ws-token

# Prototype area
AREA_NAME=kolkata-amherst
AREA_CENTER_LAT=22.5791
AREA_CENTER_LON=88.3698
AREA_HALF_SIZE_M=250

# SWMM Simulation Settings
SWMM_CATCHMENT_HA_PER_NODE=0.02
SWMM_IMPERVIOUS_PCT=100
SWMM_PONDED_AREA_M2=100

DATASET_RUNS=60
DATASET_SEED=42
DATASET_NAME=sample
DATASET_MAX_PEAK_MM_HR=80
DATASET_DOUBLE_FRACTION=0.0
